{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jarvis",
  "version": "0.1.12",
  "identifier": "ai.jarvis.v2",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/": "sidecar/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "createUpdaterArtifacts": true,
    "externalBin": []
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgMzE5QTRCMzJBN0NFRDM4OApSV1NJMDg2bk1rdWFNWXdhTEFmdUJwZlZiQWRlM0QxUkFSdDkvRXZockxEV0ZHck0veVJrTldkKwo=",
      "endpoints": [
        "https://github.com/chadowsaln/jarvis-shadow_dev/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/chadowsaln/jarvis-shadow_dev/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
